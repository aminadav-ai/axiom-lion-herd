// ============================================================================
// AXIOM LION HERD v3.0 GPU HD — True 3D Sculpted Savanna Shepherd (WebGL2)
// 100% Clean-Room Original IP • Written 100% in Axiom (Telos + Flux + Strata)
// Synthesizes 8x 256x256 Bump-Mapped Grass, Merino Fleece, Lion Mane, Timber &
// Granite Textures, 3D Savanna Plateau, Acacia Trees, Split-Rail Corral, 14 3D
// Ellipsoid Woolly Sheep & 3D Maned Lion in 8 MiB (`-[Mem, Gpu]->`) — ZERO rustc!
// ============================================================================

// --- Layer 1: Axiom.Telos Mathematically Verified Pure Kernels (Z3 SMT) ---

fn clamp_arena(v: i64) -> i64
  ens result >= 36 && result <= 988
{
  if v < 36 {
    36
  } else {
    if v > 988 { 988 } else { v }
  }
}

fn clamp_corral_x(v: i64) -> i64
  ens result >= 732 && result <= 936
{
  if v < 732 {
    732
  } else {
    if v > 936 { 936 } else { v }
  }
}

fn clamp_corral_y(v: i64) -> i64
  ens result >= 134 && result <= 346
{
  if v < 134 {
    134
  } else {
    if v > 346 { 346 } else { v }
  }
}

fn clamp_byte(v: i64) -> i64
  ens result >= 0 && result <= 255
{
  if v < 0 {
    0
  } else {
    if v > 255 { 255 } else { v }
  }
}

fn clamp_vel(v: i64, limit: i64) -> i64
  req limit >= 0
  ens result >= -limit && result <= limit
{
  if v < -limit {
    -limit
  } else {
    if v > limit { limit } else { v }
  }
}

fn abs_val(v: i64) -> i64
  ens result >= 0
{
  if v < 0 { -v } else { v }
}

fn isqrt_24bit(n: i64) -> i64
  ens result >= 0
{
  if n <= 0 {
    0
  } else {
    let mut x = n;
    let mut res = 0;
    let mut bit = 16777216;
    while bit > x max 14 {
      bit = bit >> 2;
    }
    while bit > 0 max 14 {
      if x >= res + bit {
        x = x - (res + bit);
        res = (res >> 1) + bit;
      } else {
        res = res >> 1;
      };
      bit = bit >> 2;
    }
    if res < 0 { 0 } else { res }
  }
}

fn sheep_slot_addr(idx: i64) -> i64
  req idx >= 0 && idx < 14
  ens result >= 64 && result <= 168
{
  64 + idx * 8
}

fn snapshot_slot_addr(slot: i64) -> i64
  req slot >= 0 && slot < 240
  ens result >= 512 && result < 20000
{
  512 + slot * 80
}

fn compute_herd_score(penned: i64, speed_bonus: i64) -> i64
  req penned >= 0 && penned <= 14 && speed_bonus >= 0 && speed_bonus <= 2000
  ens result >= 0 && result <= 4800
{
  penned * 200 + speed_bonus
}

fn tex256_addr(tid: i64, tx: i64, ty: i64) -> i64
  req tid >= 0 && tid < 8
{
  65536 + tid * 65536 + ((ty & 255) << 8) + (tx & 255)
}

fn pack_rgba_h(r: i64, g: i64, b: i64, h: i64) -> i64 {
  clamp_byte(r) | (clamp_byte(g) << 8) | (clamp_byte(b) << 16) | (clamp_byte(h) << 24)
}

fn pack_norm(nx: i64, ny: i64, nz: i64) -> i64 {
  clamp_byte(nx + 128) | (clamp_byte(ny + 128) << 8) | (clamp_byte(nz + 128) << 16)
}

fn pack_tint_ao(r: i64, g: i64, b: i64, ao: i64) -> i64 {
  clamp_byte(r) | (clamp_byte(g) << 8) | (clamp_byte(b) << 16) | (clamp_byte(ao) << 24)
}

// --- Layer 3: Axiom.Strata 8 MiB Linear Memory Map ---
//   0: tick             1: lion_x           2: lion_y           3: lion_vx
//   4: lion_vy          5: stamina          6: roar_timer       7: penned_count
//   8: score            9: rng_state       10: win_tick        11: snap_head
//  12: snap_count      13: lion_hop        14: lion_yaw        15: pad
//  16: sfx_event (1=roar, 2=sheep_penned_baa, 3=victory_fanfare)
//  20: static_v_cnt    21: dyn_v_cnt       22: light_cnt
//  64..175: 14 sheep * 8 words (x, y, vx, vy, penned, hop, tint, yaw)
// 300..359: 15 Shadow Casters * 4 words (world_x, world_y, world_z, radius; byte offset = 1,200)
// 512..19711: Time-Travel Ring Buffer (240 snapshots * 80 words)
// 20000..24095: 4096-entry Sine Table (-1024..1024)
// 25000..25191: Dynamic 3D Point Lights (24 * 8 words, byte offset = 100,000)
// 65536..589823: 8 Procedural 256x256 Albedo+Heightmap Textures (byte offset = 262,144; 2 MiB)
// 600000..1099999: Static 3D Savanna Plateau, Corral, Acacia Trees & Boulders VBO (byte offset = 2,400,000)
// 1100000..2049999: Dynamic 3D Sculpted Sheep, Maned Lion & Roar Shockwave VBO (byte offset = 4,400,000)

fn next_rand() -[Mem]-> i64 {
  let s = mem_load(9);
  let nxt = (s * 1103515245 + 12345) & 0x7FFFFFFF;
  let safe = if nxt == 0 { 9876543 } else { nxt };
  mem_store(9, safe);
  safe
}

fn fast_sin(ang: i64) -[Mem]-> i64 {
  mem_load(20000 + (ang & 4095))
}

fn fast_cos(ang: i64) -[Mem]-> i64 {
  mem_load(20000 + ((ang + 1024) & 4095))
}

fn init_trig_4096() -[Mem]-> unit {
  let mut i = 0;
  while i < 2048 max 2048 {
    let p = i * (2048 - i);
    let p_shr = p >> 8;
    let denom = 81920 - ((4 * p) >> 8);
    let s = if denom > 0 { (16 * p_shr * 1024) / denom } else { 0 };
    mem_store(20000 + i, s);
    mem_store(20000 + 2048 + i, -s);
    i = i + 1;
  }
}

// Approximates heading `yaw in 0..4095` where local `+Z` = `(sin(yaw), cos(yaw))` matches `(vx, vy)`!
fn yaw_from_vel(vx: i64, vy: i64, fallback: i64) -> i64 {
  if abs_val(vx) + abs_val(vy) < 1 {
    fallback & 4095
  } else {
    let raw = if abs_val(vx) > abs_val(vy) {
      if vx > 0 { 1024 - (vy * 420) / (abs_val(vx) + 1) } else { 3072 + (vy * 420) / (abs_val(vx) + 1) }
    } else {
      if vy > 0 { (vx * 420) / (abs_val(vy) + 1) } else { 2048 - (vx * 420) / (abs_val(vy) + 1) }
    };
    raw & 4095
  }
}

// --- Seamless 256x256 Savanna Grass, Merino Fleece, Lion Mane & Timber Textures ---

fn hash2d_wrap(ix: i64, iy: i64, mask: i64, seed: i64) -> i64 {
  let wx = ix & mask;
  let wy = iy & mask;
  let h1 = wx * 374761 + wy * 668265 + seed * 144269;
  let h2 = (h1 ^ (h1 >> 11)) * 12741261;
  (h2 >> 16) & 255
}

fn smooth_noise_256(x: i64, y: i64, shift: i64, seed: i64) -> i64 {
  let step = 1 << shift;
  let mask = (256 >> shift) - 1;
  let ix = x >> shift;
  let iy = y >> shift;
  let fx = ((x & (step - 1)) << 8) >> shift;
  let fy = ((y & (step - 1)) << 8) >> shift;
  let ux = (fx * fx * (768 - (fx << 1))) >> 16;
  let uy = (fy * fy * (768 - (fy << 1))) >> 16;

  let c00 = hash2d_wrap(ix, iy, mask, seed);
  let c10 = hash2d_wrap(ix + 1, iy, mask, seed);
  let c01 = hash2d_wrap(ix, iy + 1, mask, seed);
  let c11 = hash2d_wrap(ix + 1, iy + 1, mask, seed);

  let nx0 = c00 + (((c10 - c00) * ux) >> 8);
  let nx1 = c01 + (((c11 - c01) * ux) >> 8);
  nx0 + (((nx1 - nx0) * uy) >> 8)
}

fn fbm4_256(x: i64, y: i64, seed: i64) -> i64 {
  let n0 = smooth_noise_256(x, y, 5, seed);
  let n1 = smooth_noise_256(x, y, 4, seed + 23);
  let n2 = smooth_noise_256(x, y, 3, seed + 53);
  let n3 = smooth_noise_256(x, y, 2, seed + 101);
  (n0 * 116 + n1 * 72 + n2 * 44 + n3 * 24) >> 8
}

fn bake_savanna_hd_textures() -[Mem]-> unit {
  let mut y = 0;
  while y >= 0 && y < 256 max 256 {
    let mut x = 0;
    while x >= 0 && x < 256 max 256 {
      let fbm_a = fbm4_256(x, y, 17);
      let fbm_b = fbm4_256(x, y, 73);
      let fine = smooth_noise_256(x, y, 1, 163);
      let blades = smooth_noise_256((x * 3) & 255, y & 255, 1, 229);

      // ----------------------------------------------------------------------
      // TEX 0: Lush Emerald-Gold Savanna Meadow Grass & Clover Micro-Blades
      // ----------------------------------------------------------------------
      let sun_patch = (fbm_a - 128) >> 2;
      let clover = fbm_b > 168;
      let flower = fine > 236 && ((x + y) & 7) == 0;
      let h0 = clamp_byte(125 + ((blades - 128) >> 1) + ((fine - 128) >> 2));
      let r0 = if flower { 246 } else { if clover { 68 + (blades >> 4) } else { 92 + sun_patch + ((blades - 128) >> 3) } };
      let g0 = if flower { 212 } else { if clover { 138 + (blades >> 3) } else { 154 + sun_patch + ((blades - 128) >> 2) } };
      let b0 = if flower { 74 } else { if clover { 52 } else { 58 + (sun_patch >> 2) + ((fine - 128) >> 4) } };
      mem_store(tex256_addr(0, x, y), pack_rgba_h(r0, g0, b0, h0));

      // ----------------------------------------------------------------------
      // TEX 1: Golden Packed Corral Earth & Scattered Hay Straw
      // ----------------------------------------------------------------------
      let straw = smooth_noise_256((x * 4 + y) & 255, (y * 2 - x) & 255, 1, 311);
      let is_hay = straw > 178;
      let h1 = if is_hay { 215 } else { clamp_byte(130 + ((fbm_a - 128) >> 1)) };
      let r1 = if is_hay { 224 + ((fine - 128) >> 3) } else { 172 + ((fbm_a - 128) >> 2) };
      let g1 = if is_hay { 190 + ((fine - 128) >> 3) } else { 136 + ((fbm_b - 128) >> 2) };
      let b1 = if is_hay { 98 } else { 82 + ((fine - 128) >> 3) };
      mem_store(tex256_addr(1, x, y), pack_rgba_h(r1, g1, b1, h1));

      // ----------------------------------------------------------------------
      // TEX 2: Split-Rail Cedar Timber Fence & Bark Posts
      // ----------------------------------------------------------------------
      let grain = fbm4_256((x * 4) & 255, (y >> 1) & 255, 359);
      let knot = smooth_noise_256((x * 2) & 255, (y * 2) & 255, 2, 409);
      let wv = ((grain * 2 + knot) / 3) - 128;
      let iron_straps = y < 12 || y > 244;
      let h2 = if iron_straps { 230 } else { clamp_byte(158 + (wv >> 1)) };
      let r2 = if iron_straps { 74 } else { 148 + (wv >> 2) };
      let g2 = if iron_straps { 72 } else { 102 + (wv >> 2) };
      let b2 = if iron_straps { 78 } else { 62 + (wv >> 3) };
      mem_store(tex256_addr(2, x, y), pack_rgba_h(r2, g2, b2, h2));

      // ----------------------------------------------------------------------
      // TEX 3: Warm Sunlit Granite Boulders & Plateau Cliff Stone
      // ----------------------------------------------------------------------
      let crag = (((fbm_a * 3 + fine) >> 2) - 128) * 3 / 2;
      let lichen = fbm_b > 170;
      let h3 = clamp_byte(155 + (crag >> 1));
      let r3 = if lichen { 126 } else { 164 + (crag >> 2) };
      let g3 = if lichen { 142 } else { 148 + (crag >> 2) };
      let b3 = if lichen { 92 } else { 128 + (crag >> 3) };
      mem_store(tex256_addr(3, x, y), pack_rgba_h(r3, g3, b3, h3));

      // ----------------------------------------------------------------------
      // TEX 4: Fluffy Curled Merino Sheep Fleece (`y < 192`) & Velvet Snout (`y >= 192`)
      // ----------------------------------------------------------------------
      if y < 192 {
        let curl1 = smooth_noise_256((x * 3) & 255, (y * 3) & 255, 3, 461);
        let curl2 = smooth_noise_256((x * 6) & 255, (y * 6) & 255, 2, 503);
        let puff = (curl1 * 3 + curl2 * 2) / 5;
        let h4 = clamp_byte(90 + puff);
        let r4 = 236 + ((puff - 128) >> 3);
        let g4 = 232 + ((puff - 128) >> 3);
        let b4 = 218 + ((puff - 128) >> 3);
        mem_store(tex256_addr(4, x, y), pack_rgba_h(r4, g4, b4, h4));
      } else {
        // Soft charcoal-slate sheep face & hooves
        let v_fur = (fine - 128) >> 3;
        mem_store(tex256_addr(4, x, y), pack_rgba_h(58 + v_fur, 54 + v_fur, 56 + v_fur, 140 + v_fur));
      };

      // ----------------------------------------------------------------------
      // TEX 5: Golden-Tawny Lion Pelt (`y < 128`) & Shaggy Mahogany Mane (`y >= 128`)
      // ----------------------------------------------------------------------
      let strand = smooth_noise_256((x * 6) & 255, (y * 2) & 255, 2, 557);
      if y < 128 {
        let pelt = ((fbm_a + strand) >> 1) - 128;
        mem_store(tex256_addr(5, x, y), pack_rgba_h(228 + (pelt >> 2), 166 + (pelt >> 2), 72 + (pelt >> 3), 155 + (pelt >> 2)));
      } else {
        let mane = ((strand * 2 + fbm_b) / 3) - 128;
        mem_store(tex256_addr(5, x, y), pack_rgba_h(118 + (mane >> 2), 58 + (mane >> 3), 26 + (mane >> 4), clamp_byte(145 + mane)));
      };

      // ----------------------------------------------------------------------
      // TEX 6: Lush Acacia Canopy Leaves
      // ----------------------------------------------------------------------
      let leaf = smooth_noise_256((x * 4) & 255, (y * 4) & 255, 2, 613);
      let lv = ((leaf * 2 + fbm_a) / 3) - 128;
      mem_store(tex256_addr(6, x, y), pack_rgba_h(66 + (lv >> 2), 136 + (lv >> 2), 48 + (lv >> 3), clamp_byte(140 + (lv >> 1))));

      // ----------------------------------------------------------------------
      // TEX 7: Gleaming Shepherd Brass, Emerald Collar & Roar Gold
      // ----------------------------------------------------------------------
      let gleam = (fine - 128) >> 3;
      mem_store(tex256_addr(7, x, y), pack_rgba_h(238 + gleam, 194 + gleam, 78 + gleam, 215 + gleam));

      x = x + 1;
    }
    y = y + 1;
  }
}

// --- 3D Polygonal & Smooth Ellipsoid Mesh Builders (`buf_kind`: 0=Static Savanna, 1=Dynamic Flock & Lion) ---

fn push_vertex(
  buf_kind: i64,
  x: i64, y: i64, z: i64,
  norm_packed: i64,
  u: i64, v: i64,
  tex_flags: i64,
  col_ao: i64
) -[Mem]-> unit {
  if buf_kind == 0 {
    let idx = mem_load(20);
    if idx < 62000 {
      let base = 600000 + idx * 8;
      mem_store(base, x);
      mem_store(base + 1, y);
      mem_store(base + 2, z);
      mem_store(base + 3, norm_packed);
      mem_store(base + 4, u);
      mem_store(base + 5, v);
      mem_store(base + 6, tex_flags);
      mem_store(base + 7, col_ao);
      mem_store(20, idx + 1);
    } else { () }
  } else {
    let idx = mem_load(21);
    if idx < 115000 {
      let base = 1100000 + idx * 8;
      mem_store(base, x);
      mem_store(base + 1, y);
      mem_store(base + 2, z);
      mem_store(base + 3, norm_packed);
      mem_store(base + 4, u);
      mem_store(base + 5, v);
      mem_store(base + 6, tex_flags);
      mem_store(base + 7, col_ao);
      mem_store(21, idx + 1);
    } else { () }
  }
}

fn emit_quad_3d(
  buf_kind: i64,
  x0: i64, y0: i64, z0: i64, u0: i64, v0: i64, ao0: i64,
  x1: i64, y1: i64, z1: i64, u1: i64, v1: i64, ao1: i64,
  x2: i64, y2: i64, z2: i64, u2: i64, v2: i64, ao2: i64,
  x3: i64, y3: i64, z3: i64, u3: i64, v3: i64, ao3: i64,
  tex_flags: i64,
  tr: i64, tg: i64, tb: i64
) -[Mem]-> unit {
  let ux = (x1 - x0) >> 2;
  let uy = (y1 - y0) >> 2;
  let uz = (z1 - z0) >> 2;
  let vx = (x3 - x0) >> 2;
  let vy = (y3 - y0) >> 2;
  let vz = (z3 - z0) >> 2;

  let cx = (uy * vz - uz * vy) >> 6;
  let cy = (uz * vx - ux * vz) >> 6;
  let cz = (ux * vy - uy * vx) >> 6;
  let len = isqrt_24bit(cx * cx + cy * cy + cz * cz);
  let safe_len = if len <= 0 { 1 } else { len };
  let n_pack = pack_norm((cx * 127) / safe_len, (cy * 127) / safe_len, (cz * 127) / safe_len);

  let c0 = pack_tint_ao(tr, tg, tb, ao0);
  let c1 = pack_tint_ao(tr, tg, tb, ao1);
  let c2 = pack_tint_ao(tr, tg, tb, ao2);
  let c3 = pack_tint_ao(tr, tg, tb, ao3);

  push_vertex(buf_kind, x0, y0, z0, n_pack, u0, v0, tex_flags, c0);
  push_vertex(buf_kind, x1, y1, z1, n_pack, u1, v1, tex_flags, c1);
  push_vertex(buf_kind, x2, y2, z2, n_pack, u2, v2, tex_flags, c2);

  push_vertex(buf_kind, x0, y0, z0, n_pack, u0, v0, tex_flags, c0);
  push_vertex(buf_kind, x2, y2, z2, n_pack, u2, v2, tex_flags, c2);
  push_vertex(buf_kind, x3, y3, z3, n_pack, u3, v3, tex_flags, c3);
}

fn emit_smooth_quad_3d(
  buf_kind: i64,
  x0: i64, y0: i64, z0: i64, n0: i64, u0: i64, v0: i64, ao0: i64,
  x1: i64, y1: i64, z1: i64, n1: i64, u1: i64, v1: i64, ao1: i64,
  x2: i64, y2: i64, z2: i64, n2: i64, u2: i64, v2: i64, ao2: i64,
  x3: i64, y3: i64, z3: i64, n3: i64, u3: i64, v3: i64, ao3: i64,
  tex_flags: i64,
  tr: i64, tg: i64, tb: i64
) -[Mem]-> unit {
  let c0 = pack_tint_ao(tr, tg, tb, ao0);
  let c1 = pack_tint_ao(tr, tg, tb, ao1);
  let c2 = pack_tint_ao(tr, tg, tb, ao2);
  let c3 = pack_tint_ao(tr, tg, tb, ao3);
  let tf = tex_flags | 32;

  push_vertex(buf_kind, x0, y0, z0, n0, u0, v0, tf, c0);
  push_vertex(buf_kind, x1, y1, z1, n1, u1, v1, tf, c1);
  push_vertex(buf_kind, x2, y2, z2, n2, u2, v2, tf, c2);

  push_vertex(buf_kind, x0, y0, z0, n0, u0, v0, tf, c0);
  push_vertex(buf_kind, x2, y2, z2, n2, u2, v2, tf, c2);
  push_vertex(buf_kind, x3, y3, z3, n3, u3, v3, tf, c3);
}

fn emit_box_3d(
  buf_kind: i64,
  x0: i64, y0: i64, z0: i64,
  x1: i64, y1: i64, z1: i64,
  tex_id: i64,
  u_max: i64, v_max: i64,
  tr: i64, tg: i64, tb: i64,
  ao_bot: i64, ao_top: i64
) -[Mem]-> unit {
  emit_quad_3d(buf_kind, x0, y1, z1, 0, v_max, ao_top, x1, y1, z1, u_max, v_max, ao_top, x1, y1, z0, u_max, 0, ao_top, x0, y1, z0, 0, 0, ao_top, tex_id, tr, tg, tb);
  emit_quad_3d(buf_kind, x0, y0, z1, 0, 1024, ao_bot, x1, y0, z1, u_max, 1024, ao_bot, x1, y1, z1, u_max, 0, ao_top, x0, y1, z1, 0, 0, ao_top, tex_id, tr, tg, tb);
  emit_quad_3d(buf_kind, x1, y0, z0, 0, 1024, ao_bot, x0, y0, z0, u_max, 1024, ao_bot, x0, y1, z0, u_max, 0, ao_top, x1, y1, z0, 0, 0, ao_top, tex_id, tr, tg, tb);
  emit_quad_3d(buf_kind, x0, y0, z0, 0, 1024, ao_bot, x0, y0, z1, v_max, 1024, ao_bot, x0, y1, z1, v_max, 0, ao_top, x0, y1, z0, 0, 0, ao_top, tex_id, tr, tg, tb);
  emit_quad_3d(buf_kind, x1, y0, z1, 0, 1024, ao_bot, x1, y0, z0, v_max, 1024, ao_bot, x1, y1, z0, v_max, 0, ao_top, x1, y1, z1, 0, 0, ao_top, tex_id, tr, tg, tb);
}

// Emits a Plush Smooth-Shaded Oriented 3D Ellipsoid (`8 x 5 = 80` triangles) rotated around Y by `yaw`!
fn emit_ellipsoid_3d(
  buf_kind: i64,
  cx: i64, cy: i64, cz: i64,
  yaw: i64,
  lx_off: i64, ly_off: i64, lz_off: i64,
  rx: i64, ry: i64, rz: i64,
  tex_flags: i64,
  u0: i64, v0: i64, u1: i64, v1: i64,
  tr: i64, tg: i64, tb: i64
) -[Mem]-> unit {
  let cyaw = fast_cos(yaw);
  let syaw = fast_sin(yaw);
  let ox = cx + ((lx_off * cyaw + lz_off * syaw) >> 10);
  let oy = cy + ly_off;
  let oz = cz + ((-lx_off * syaw + lz_off * cyaw) >> 10);

  let mut lat = 0;
  while lat < 5 max 5 {
    let phi0 = -1024 + (lat * 2048) / 5;
    let phi1 = -1024 + ((lat + 1) * 2048) / 5;
    let cp0 = fast_cos(phi0);
    let sp0 = fast_sin(phi0);
    let cp1 = fast_cos(phi1);
    let sp1 = fast_sin(phi1);

    let y0 = oy + ((ry * sp0) >> 10);
    let y1 = oy + ((ry * sp1) >> 10);
    let ny0 = (sp0 * 126) >> 10;
    let ny1 = (sp1 * 126) >> 10;
    let ao0 = 165 + ((sp0 + 1024) * 44) / 1024;
    let ao1 = 165 + ((sp1 + 1024) * 44) / 1024;

    let mut lon = 0;
    while lon < 8 max 8 {
      let th0 = (lon * 4096) / 8;
      let th1 = ((lon + 1) * 4096) / 8;
      let ct0 = fast_cos(th0);
      let st0 = fast_sin(th0);
      let ct1 = fast_cos(th1);
      let st1 = fast_sin(th1);

      let ux00 = (cp0 * ct0) >> 10;
      let uz00 = (cp0 * st0) >> 10;
      let ux10 = (cp0 * ct1) >> 10;
      let uz10 = (cp0 * st1) >> 10;
      let ux11 = (cp1 * ct1) >> 10;
      let uz11 = (cp1 * st1) >> 10;
      let ux01 = (cp1 * ct0) >> 10;
      let uz01 = (cp1 * st0) >> 10;

      // Local ellipsoid points -> rotated by `yaw`!
      let lx00 = (rx * ux00) >> 10;
      let lz00 = (rz * uz00) >> 10;
      let lx10 = (rx * ux10) >> 10;
      let lz10 = (rz * uz10) >> 10;
      let lx11 = (rx * ux11) >> 10;
      let lz11 = (rz * uz11) >> 10;
      let lx01 = (rx * ux01) >> 10;
      let lz01 = (rz * uz01) >> 10;

      let x00 = ox + ((lx00 * cyaw + lz00 * syaw) >> 10);
      let z00 = oz + ((-lx00 * syaw + lz00 * cyaw) >> 10);
      let x10 = ox + ((lx10 * cyaw + lz10 * syaw) >> 10);
      let z10 = oz + ((-lx10 * syaw + lz10 * cyaw) >> 10);
      let x11 = ox + ((lx11 * cyaw + lz11 * syaw) >> 10);
      let z11 = oz + ((-lx11 * syaw + lz11 * cyaw) >> 10);
      let x01 = ox + ((lx01 * cyaw + lz01 * syaw) >> 10);
      let z01 = oz + ((-lx01 * syaw + lz01 * cyaw) >> 10);

      let wnx00 = ((ux00 * cyaw + uz00 * syaw) * 126) >> 20;
      let wnz00 = ((-ux00 * syaw + uz00 * cyaw) * 126) >> 20;
      let wnx10 = ((ux10 * cyaw + uz10 * syaw) * 126) >> 20;
      let wnz10 = ((-ux10 * syaw + uz10 * cyaw) * 126) >> 20;
      let wnx11 = ((ux11 * cyaw + uz11 * syaw) * 126) >> 20;
      let wnz11 = ((-ux11 * syaw + uz11 * cyaw) * 126) >> 20;
      let wnx01 = ((ux01 * cyaw + uz01 * syaw) * 126) >> 20;
      let wnz01 = ((-ux01 * syaw + uz01 * cyaw) * 126) >> 20;

      let np00 = pack_norm(wnx00, ny0, wnz00);
      let np10 = pack_norm(wnx10, ny0, wnz10);
      let np11 = pack_norm(wnx11, ny1, wnz11);
      let np01 = pack_norm(wnx01, ny1, wnz01);

      let su0 = u0 + ((u1 - u0) * lon) / 8;
      let su1 = u0 + ((u1 - u0) * (lon + 1)) / 8;
      let sv0 = v0 + ((v1 - v0) * lat) / 5;
      let sv1 = v0 + ((v1 - v0) * (lat + 1)) / 5;

      emit_smooth_quad_3d(buf_kind,
        x00, y0, z00, np00, su0, sv0, ao0,
        x10, y0, z10, np10, su1, sv0, ao0,
        x11, y1, z11, np11, su1, sv1, ao1,
        x01, y1, z01, np01, su0, sv1, ao1,
        tex_flags, tr, tg, tb);

      lon = lon + 1;
    }
    lat = lat + 1;
  }
}

// Emits a Tapered Smooth-Normal 3D Leg/Limb rotated around Y by `yaw`!
fn emit_limb_3d(
  buf_kind: i64,
  cx: i64, cy: i64, cz: i64, yaw: i64,
  lx0: i64, ly0: i64, lz0: i64,
  lx1: i64, ly1: i64, lz1: i64,
  tex_flags: i64,
  u0: i64, v0: i64, u1: i64, v1: i64,
  tr: i64, tg: i64, tb: i64
) -[Mem]-> unit {
  let c = fast_cos(yaw);
  let s = fast_sin(yaw);

  let x00 = cx + ((lx0 * c + lz0 * s) >> 10);
  let z00 = cz + ((-lx0 * s + lz0 * c) >> 10);
  let x10 = cx + ((lx1 * c + lz0 * s) >> 10);
  let z10 = cz + ((-lx1 * s + lz0 * c) >> 10);
  let x11 = cx + ((lx1 * c + lz1 * s) >> 10);
  let z11 = cz + ((-lx1 * s + lz1 * c) >> 10);
  let x01 = cx + ((lx0 * c + lz1 * s) >> 10);
  let z01 = cz + ((-lx0 * s + lz1 * c) >> 10);

  let n00 = pack_norm((-88 * c - 88 * s) >> 10, 24, (88 * s - 88 * c) >> 10);
  let n10 = pack_norm((88 * c - 88 * s) >> 10, 24, (-88 * s - 88 * c) >> 10);
  let n11 = pack_norm((88 * c + 88 * s) >> 10, 24, (-88 * s + 88 * c) >> 10);
  let n01 = pack_norm((-88 * c + 88 * s) >> 10, 24, (88 * s + 88 * c) >> 10);

  let y_b = cy + ly0;
  let y_t = cy + ly1;

  emit_smooth_quad_3d(buf_kind, x01, y_b, z01, n01, u0, v1, 175, x11, y_b, z11, n11, u1, v1, 175, x11, y_t, z11, n11, u1, v0, 240, x01, y_t, z01, n01, u0, v0, 240, tex_flags, tr, tg, tb);
  emit_smooth_quad_3d(buf_kind, x10, y_b, z10, n10, u0, v1, 170, x00, y_b, z00, n00, u1, v1, 170, x00, y_t, z00, n00, u1, v0, 235, x10, y_t, z10, n10, u0, v0, 235, tex_flags, tr, tg, tb);
  emit_smooth_quad_3d(buf_kind, x00, y_b, z00, n00, u0, v1, 172, x01, y_b, z01, n01, u1, v1, 172, x01, y_t, z01, n01, u1, v0, 238, x00, y_t, z00, n00, u0, v0, 238, tex_flags, tr, tg, tb);
  emit_smooth_quad_3d(buf_kind, x11, y_b, z11, n11, u0, v1, 172, x10, y_b, z10, n10, u1, v1, 172, x10, y_t, z10, n10, u1, v0, 238, x11, y_t, z11, n11, u0, v0, 238, tex_flags, tr, tg, tb);
  emit_smooth_quad_3d(buf_kind, x01, y_t, z01, n01, u0, v1, 248, x11, y_t, z11, n11, u1, v1, 248, x10, y_t, z10, n10, u1, v0, 248, x00, y_t, z00, n00, u0, v0, 248, tex_flags, tr, tg, tb);
}

fn push_light(x: i64, y: i64, z: i64, rad: i64, r: i64, g: i64, b: i64) -[Mem]-> unit {
  let lc = mem_load(22);
  if lc < 20 {
    let base = 25000 + lc * 8;
    mem_store(base, x);
    mem_store(base + 1, y);
    mem_store(base + 2, z);
    mem_store(base + 3, rad);
    mem_store(base + 4, r);
    mem_store(base + 5, g);
    mem_store(base + 6, b);
    mem_store(base + 7, 1);
    mem_store(22, lc + 1);
  } else { () }
}

// Emits a Sculpted 3D Savanna Acacia Tree at `(tx, tz)`!
fn emit_acacia_tree_3d(tx: i64, tz: i64, scale_pct: i64) -[Mem]-> unit {
  let th = (1750 * scale_pct) / 100;
  let cr = (1280 * scale_pct) / 100;
  // Gnarled cedar/bark trunk + 2 upper branches
  emit_limb_3d(0, tx, 0, tz, 300, -130, 0, -130, 130, th, 130, 2, 0, 0, 512, 1024, 185, 155, 125);
  // Wide flat-topped African Acacia foliage umbrellas (`Tex 6`)!
  emit_ellipsoid_3d(0, tx, th + 120, tz, 0, 0, 0, 0, cr, 280, cr, 6, 0, 0, 1024, 1024, 235, 245, 215);
  emit_ellipsoid_3d(0, tx - cr / 2, th - 60, tz + cr / 3, 0, 0, 0, 0, (cr * 2) / 3, 220, (cr * 2) / 3, 6, 0, 0, 1024, 1024, 220, 238, 200);
  emit_ellipsoid_3d(0, tx + cr / 2, th + 240, tz - cr / 3, 0, 0, 0, 0, (cr * 3) / 4, 230, (cr * 3) / 4, 6, 0, 0, 1024, 1024, 248, 252, 225);
}

// Builds the Static 3D Savanna Plateau, Timber Corral, Gate Lanterns, Acacia Trees & Granite Boulders!
fn build_savanna_3d_world() -[Mem]-> unit {
  mem_store(20, 0);

  // 1. Savanna Meadow Plateau (`wx, wy in 0..1024` -> `X, Z in [-5120 .. +5120]`)
  emit_quad_3d(0,
    -5250, 0, 5250, 0, 6144, 248,
    5250, 0, 5250, 6144, 6144, 248,
    5250, 0, -5250, 6144, 0, 248,
    -5250, 0, -5250, 0, 0, 248,
    0, 250, 252, 242);
  // Craggy Granite Cliff Skirt framing the savanna island (`Y = -580 .. 0`, `Tex 3`)
  emit_box_3d(0, -5420, -580, -5420, 5420, -2, 5420, 3, 4096, 1024, 235, 225, 210, 130, 225);

  // 2. Golden Packed Corral Straw Floor (`wx in 700..966 -> X in 1880..4540`, `wy in 104..376 -> Z in -4080..-1360`)
  emit_quad_3d(0,
    1880, 14, -1360, 0, 2048, 245,
    4540, 14, -1360, 2048, 2048, 245,
    4540, 14, -4080, 2048, 0, 245,
    1880, 14, -4080, 0, 0, 245,
    1, 250, 245, 235);

  // 3. True 3D Split-Rail Cedar Corral Fence (`Tex 2`)!
  // North Fence (`Z = -4080, X = 1880..4540`) — 2 horizontal rails + 4 posts
  emit_box_3d(0, 1880, 230, -4135, 4540, 350, -4025, 2, 3072, 512, 245, 235, 220, 165, 245);
  emit_box_3d(0, 1880, 520, -4135, 4540, 640, -4025, 2, 3072, 512, 248, 238, 224, 175, 250);
  // South Fence (`Z = -1360, X = 1880..4540`)
  emit_box_3d(0, 1880, 230, -1415, 4540, 350, -1305, 2, 3072, 512, 245, 235, 220, 165, 245);
  emit_box_3d(0, 1880, 520, -1415, 4540, 640, -1305, 2, 3072, 512, 248, 238, 224, 175, 250);
  // East Back Fence (`X = 4540, Z = -4080..-1360`)
  emit_box_3d(0, 4485, 230, -4080, 4595, 350, -1360, 2, 512, 3072, 245, 235, 220, 165, 245);
  emit_box_3d(0, 4485, 520, -4080, 4595, 640, -1360, 2, 512, 3072, 248, 238, 224, 175, 250);
  // West Front Flanks (`X = 1880`, leaving open Gate `Z = -3470 .. -1970`!)
  emit_box_3d(0, 1825, 230, -4080, 1935, 350, -3470, 2, 512, 1024, 245, 235, 220, 165, 245);
  emit_box_3d(0, 1825, 520, -4080, 1935, 640, -3470, 2, 512, 1024, 248, 238, 224, 175, 250);
  emit_box_3d(0, 1825, 230, -1970, 1935, 350, -1360, 2, 512, 1024, 245, 235, 220, 165, 245);
  emit_box_3d(0, 1825, 520, -1970, 1935, 640, -1360, 2, 512, 1024, 248, 238, 224, 175, 250);

  // Heavy Timber Corner Posts & Tall Shepherd Gate Archway (`Y = 0..1380`)!
  emit_box_3d(0, 1790, 0, -4170, 1970, 820, -3990, 2, 512, 1024, 215, 195, 175, 145, 240);
  emit_box_3d(0, 4450, 0, -4170, 4630, 820, -3990, 2, 512, 1024, 215, 195, 175, 145, 240);
  emit_box_3d(0, 4450, 0, -1450, 4630, 820, -1270, 2, 512, 1024, 215, 195, 175, 145, 240);
  emit_box_3d(0, 1790, 0, -1450, 1970, 820, -1270, 2, 512, 1024, 215, 195, 175, 145, 240);
  emit_box_3d(0, 3120, 0, -4160, 3280, 780, -4000, 2, 512, 1024, 215, 195, 175, 145, 240);
  emit_box_3d(0, 3120, 0, -1440, 3280, 780, -1280, 2, 512, 1024, 215, 195, 175, 145, 240);

  // Twin Tall Gate Pillars + Overhead Timber Sign Beam welcoming the flock!
  emit_box_3d(0, 1780, 0, -3560, 1980, 1420, -3360, 2, 512, 1024, 225, 205, 182, 145, 245);
  emit_box_3d(0, 1780, 0, -2080, 1980, 1420, -1880, 2, 512, 1024, 225, 205, 182, 145, 245);
  emit_box_3d(0, 1750, 1280, -3640, 2010, 1480, -1800, 2, 2048, 512, 238, 218, 195, 170, 250);
  // Glowing Golden Shepherd Lanterns on both Gate Pillars!
  emit_box_3d(0, 1660, 980, -3530, 1820, 1180, -3390, 7 + 16, 512, 512, 255, 210, 85, 255, 255);
  emit_box_3d(0, 1660, 980, -2050, 1820, 1180, -1910, 7 + 16, 512, 512, 255, 210, 85, 255, 255);

  // 4. Sculpted 3D Savanna Acacia Trees & Granite Boulders framing the Back/Side Meadow Rim!
  emit_acacia_tree_3d(-4750, -4550, 108);
  emit_acacia_tree_3d(-4850, 3850, 96);
  emit_acacia_tree_3d(4650, -4750, 94);
  emit_acacia_tree_3d(-1500, -4900, 90);

  emit_ellipsoid_3d(0, -4600, 140, -800, 400, 0, 0, 0, 480, 260, 360, 3, 0, 0, 1024, 1024, 235, 225, 210);
  emit_ellipsoid_3d(0, -800, 120, -4750, 1100, 0, 0, 0, 520, 240, 380, 3, 0, 0, 1024, 1024, 230, 220, 205);
  emit_ellipsoid_3d(0, 1200, 130, 4750, 700, 0, 0, 0, 460, 230, 340, 3, 0, 0, 1024, 1024, 238, 228, 212);
}

// Emits a Sculpted 3D Woolly Merino Sheep (`idx: 0..13`)!
fn emit_sheep_3d(idx: i64) -[Mem]-> unit {
  if idx >= 0 && idx < 14 {
    let addr = sheep_slot_addr(idx);
    let wx = (mem_load(addr) - 512) * 10;
    let wz = (mem_load(addr + 1) - 512) * 10;
    let penned = mem_load(addr + 4);
    let hop = mem_load(addr + 5);
    let tint = mem_load(addr + 6);
    let yaw = mem_load(addr + 7);

    let bounce = abs_val((fast_sin(hop * 128) * 95) >> 10);
    let leg_sw = (fast_sin(hop * 128) * 58) >> 10;

    // Record shadow caster (`300 + (idx + 1) * 4`)
    let sb = 300 + (idx + 1) * 4;
    mem_store(sb, wx);
    mem_store(sb + 1, bounce);
    mem_store(sb + 2, wz);
    mem_store(sb + 3, 310);

    let wr = if tint == 0 { 252 } else { if tint == 1 { 244 } else { 236 } };
    let wg = if tint == 0 { 248 } else { if tint == 1 { 236 } else { 226 } };
    let wb = if tint == 0 { 238 } else { if tint == 1 { 218 } else { 206 } };

    // 4 Animated Trotting Dark-Velvet Legs (`Tex 4` lower region `v: 800..1000`)
    emit_limb_3d(1, wx, bounce, wz, yaw, -125, 0, 110 + leg_sw, -65, 220, 170 + leg_sw, 4, 0, 800, 256, 1000, 95, 88, 90);
    emit_limb_3d(1, wx, bounce, wz, yaw, 65, 0, 110 - leg_sw, 125, 220, 170 - leg_sw, 4, 0, 800, 256, 1000, 95, 88, 90);
    emit_limb_3d(1, wx, bounce, wz, yaw, -125, 0, -170 - leg_sw, -65, 220, -110 - leg_sw, 4, 0, 800, 256, 1000, 95, 88, 90);
    emit_limb_3d(1, wx, bounce, wz, yaw, 65, 0, -170 + leg_sw, 125, 220, -110 + leg_sw, 4, 0, 800, 256, 1000, 95, 88, 90);

    // Multi-Puff 3D Curled Merino Wool Body (`Tex 4` upper curled wool `v: 0..720`)!
    emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 310, 0, 205, 175, 265, 4, 0, 0, 1024, 720, wr, wg, wb);
    emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 355, 85, 175, 150, 175, 4, 0, 0, 768, 720, wr, wg, wb);
    emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 330, -125, 170, 145, 165, 4, 0, 0, 768, 720, wr, wg, wb);
    // Cute woolly tail puff
    emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 320, -285, 65, 58, 75, 4, 0, 0, 512, 512, wr, wg, wb);

    // Golden / Emerald Shepherd Bell Collar (`Tex 7`)
    if penned == 1 {
      emit_limb_3d(1, wx, bounce, wz, yaw, -135, 265, 175, 135, 395, 235, 7 + 16, 0, 0, 512, 512, 95, 250, 145);
    } else {
      emit_limb_3d(1, wx, bounce, wz, yaw, -130, 265, 175, 130, 385, 230, 7, 0, 0, 512, 512, 245, 198, 72);
    };

    // Sculpted Dark Velvet Sheep Head + Fluffy Forehead Wool Tuft + Floppy Ears + Gleaming Eyes!
    emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 385, 285, 108, 102, 145, 4, 0, 800, 512, 1000, 105, 98, 102);
    emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 468, 255, 92, 62, 95, 4, 0, 0, 512, 600, wr, wg, wb);
    // Floppy left & right ears
    emit_limb_3d(1, wx, bounce, wz, yaw, -175, 365, 235, -95, 405, 285, 4, 0, 800, 256, 1000, 92, 84, 88);
    emit_limb_3d(1, wx, bounce, wz, yaw, 95, 365, 235, 175, 405, 285, 4, 0, 800, 256, 1000, 92, 84, 88);
    // Bright white eyes
    emit_limb_3d(1, wx, bounce, wz, yaw, -96, 402, 345, -62, 432, 385, 7 + 16, 0, 0, 128, 128, 250, 250, 245);
    emit_limb_3d(1, wx, bounce, wz, yaw, 62, 402, 345, 96, 432, 385, 7 + 16, 0, 0, 128, 128, 250, 250, 245);
  } else { () }
}

// Emits the Sculpted 3D Regal Maned Lion + Expanding Golden Roar Shockwave Ring!
fn emit_lion_3d() -[Mem]-> unit {
  let wx = (mem_load(1) - 512) * 10;
  let wz = (mem_load(2) - 512) * 10;
  let roar_t = mem_load(6);
  let hop = mem_load(13);
  let yaw = mem_load(14);
  let tick = mem_load(0);

  let bounce = abs_val((fast_sin(hop * 256) * 110) >> 10);
  let stride = (fast_sin(hop * 256) * 95) >> 10;

  // Record Lion shadow caster (`300 + 0`)
  mem_store(300, wx);
  mem_store(301, bounce);
  mem_store(302, wz);
  mem_store(303, 420);

  // 1. 4 Powerful Galloping Tawny Legs & Broad Paws (`Tex 5` top half `v: 0..480`)
  emit_limb_3d(1, wx, bounce, wz, yaw, -155, 0, 165 + stride, -70, 310, 255 + stride, 5, 0, 0, 512, 480, 245, 232, 210);
  emit_limb_3d(1, wx, bounce, wz, yaw, 70, 0, 165 - stride, 155, 310, 255 - stride, 5, 0, 0, 512, 480, 245, 232, 210);
  emit_limb_3d(1, wx, bounce, wz, yaw, -155, 0, -245 - stride, -70, 310, -155 - stride, 5, 0, 0, 512, 480, 238, 224, 202);
  emit_limb_3d(1, wx, bounce, wz, yaw, 70, 0, -245 + stride, 155, 310, -155 + stride, 5, 0, 0, 512, 480, 238, 224, 202);

  // 2. Muscular Tawny Chest & Lithe Haunches (`Tex 5` top half)
  emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 365, -80, 175, 155, 290, 5, 0, 0, 1024, 480, 250, 240, 225);
  emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 405, 115, 205, 182, 215, 5, 0, 0, 1024, 480, 252, 244, 230);

  // Whipping Tawny Tail + Dark Mahogany Tail Tuft!
  let wag = (fast_sin(tick * 160) * 110) >> 10;
  emit_limb_3d(1, wx, bounce, wz, yaw, wag - 28, 380, -490, wag + 28, 520, -320, 5, 0, 0, 256, 480, 242, 228, 205);
  emit_ellipsoid_3d(1, wx, bounce, wz, yaw, wag, 540, -515, 58, 58, 72, 5, 0, 540, 512, 1000, 235, 215, 195);

  // 3. Colossal Multi-Ring Shaggy Mahogany Lion Mane (`Tex 5` lower half `v: 540..1000`)!
  emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 475, 215, 295, 275, 235, 5, 0, 540, 1024, 1000, 248, 235, 220);
  emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 515, 295, 255, 245, 185, 5, 0, 540, 1024, 1000, 255, 242, 225);

  // 4. Sculpted Regal Lion Face, Broad Golden Snout, Rounded Ears & Fierce Amber Eyes!
  emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 505, 385, 145, 132, 165, 5, 0, 0, 512, 480, 252, 242, 225);
  emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 0, 465, 495, 105, 82, 105, 5, 0, 0, 512, 480, 255, 248, 235);
  // Dark nose tip
  emit_limb_3d(1, wx, bounce, wz, yaw, -38, 495, 575, 38, 530, 605, 4, 0, 820, 256, 1000, 65, 52, 52);
  // Rounded golden ears peeking out of the mane
  emit_ellipsoid_3d(1, wx, bounce, wz, yaw, -165, 685, 315, 58, 62, 42, 5, 0, 0, 256, 480, 245, 230, 205);
  emit_ellipsoid_3d(1, wx, bounce, wz, yaw, 165, 685, 315, 58, 62, 42, 5, 0, 0, 256, 480, 245, 230, 205);
  // Glowing golden-amber eyes
  emit_limb_3d(1, wx, bounce, wz, yaw, -95, 535, 510, -52, 568, 545, 7 + 16, 0, 0, 256, 256, 255, 215, 60);
  emit_limb_3d(1, wx, bounce, wz, yaw, 52, 535, 510, 95, 568, 545, 7 + 16, 0, 0, 256, 256, 255, 215, 60);

  // 5. Expanding 3D Luminous Golden Roar Shockwave Ring + Dynamic Point Light when Roaring!
  if roar_t > 0 {
    let prog = 25 - roar_t; // 1..24
    let r_in = 380 + prog * 135;
    let r_out = r_in + 165;
    let mut seg = 0;
    while seg < 20 max 20 {
      let a0 = (seg * 4096) / 20;
      let a1 = ((seg + 1) * 4096) / 20;
      let c0 = fast_cos(a0);
      let s0 = fast_sin(a0);
      let c1 = fast_cos(a1);
      let s1 = fast_sin(a1);

      emit_quad_3d(1,
        wx + ((r_in * c0) >> 10), 45, wz + ((r_in * s0) >> 10), 0, 0, 255,
        wx + ((r_out * c0) >> 10), 65, wz + ((r_out * s0) >> 10), 512, 0, 255,
        wx + ((r_out * c1) >> 10), 65, wz + ((r_out * s1) >> 10), 512, 512, 255,
        wx + ((r_in * c1) >> 10), 45, wz + ((r_in * s1) >> 10), 0, 512, 255,
        7 + 16, 255, 198, 62);
      seg = seg + 1;
    }
    push_light(wx, 850, wz, 5800, 255, 195, 68);
  } else { () };
}

fn build_dynamic_savanna_3d() -[Mem, Gpu]-> i64 {
  mem_store(21, 0);
  mem_store(22, 0);

  // Warm Shepherd Gate Lantern Point Lights!
  push_light(1740, 1120, -3460, 4800, 255, 195, 82);
  push_light(1740, 1120, -1980, 4800, 255, 195, 82);

  emit_lion_3d();

  let mut i = 0;
  while i >= 0 && i < 14 max 14 {
    emit_sheep_3d(i);
    i = i + 1;
  }

  do Gpu.submit(mem_load(20), mem_load(21));
  262144
}

// --- Boids Flock Simulation, Lion Steering & Time-Travel Snapshots ---

fn save_snapshot() -[Mem]-> unit {
  let head = mem_load(11);
  let safe_slot = if head < 0 { 0 } else { if head >= 240 { 0 } else { head } };
  let base = snapshot_slot_addr(safe_slot);

  let mut h = 0;
  while h >= 0 && h < 16 max 16 {
    mem_store(base + h, mem_load(h));
    h = h + 1;
  }

  let mut s = 0;
  while s >= 0 && s < 14 max 14 {
    let saddr = sheep_slot_addr(s);
    let daddr = base + 16 + s * 4;
    let packed_pos = ((mem_load(saddr) & 2047) << 12) | (mem_load(saddr + 1) & 2047);
    let packed_vel = ((mem_load(saddr + 2) + 64) << 8) | ((mem_load(saddr + 3) + 64) & 255);
    let meta = ((mem_load(saddr + 4) & 3) << 20)
             | ((mem_load(saddr + 5) & 31) << 15)
             | ((mem_load(saddr + 6) & 7) << 12)
             | (mem_load(saddr + 7) & 4095);
    mem_store(daddr, packed_pos);
    mem_store(daddr + 1, packed_vel);
    mem_store(daddr + 2, meta);
    s = s + 1;
  }

  let next_head = if safe_slot + 1 >= 240 { 0 } else { safe_slot + 1 };
  mem_store(11, next_head);
  let cnt = mem_load(12);
  if cnt < 240 {
    mem_store(12, cnt + 1);
  } else { () }
}

fn step_sheep_flock(lion_x: i64, lion_y: i64, roaring: i64) -[Mem]-> i64 {
  let scare_radius = if roaring > 0 { 360 } else { 225 };
  let scare_sq = scare_radius * scare_radius;
  let mut penned_total = 0;

  let mut i = 0;
  while i >= 0 && i < 14 max 14 {
    let addr = sheep_slot_addr(i);
    let sx = mem_load(addr);
    let sy = mem_load(addr + 1);
    let svx = mem_load(addr + 2);
    let svy = mem_load(addr + 3);
    let state = mem_load(addr + 4);
    let hop = mem_load(addr + 5);
    let prev_yaw = mem_load(addr + 7);

    if state == 1 {
      let jitter = next_rand();
      let jx = if (jitter & 31) == 0 { ((jitter >> 5) & 3) - 1 } else { 0 };
      let jy = if (jitter & 31) == 7 { ((jitter >> 8) & 3) - 1 } else { 0 };
      let nvx = clamp_vel(svx + jx, 2);
      let nvy = clamp_vel(svy + jy, 2);
      let nx = clamp_corral_x(sx + nvx);
      let ny = clamp_corral_y(sy + nvy);
      let bvx = if nx == 732 || nx == 936 { -nvx } else { nvx };
      let bvy = if ny == 134 || ny == 346 { -nvy } else { nvy };
      let nyaw = yaw_from_vel(bvx, bvy, prev_yaw);
      mem_store(addr, nx);
      mem_store(addr + 1, ny);
      mem_store(addr + 2, bvx);
      mem_store(addr + 3, bvy);
      mem_store(addr + 5, (hop + 1) & 31);
      mem_store(addr + 7, nyaw);
      penned_total = penned_total + 1;
    } else {
      let mut sep_x = 0;
      let mut sep_y = 0;
      let mut coh_x = 0;
      let mut coh_y = 0;
      let mut ali_x = 0;
      let mut ali_y = 0;
      let mut neighbors = 0;

      let mut j = 0;
      while j >= 0 && j < 14 max 14 {
        if j != i {
          let oaddr = sheep_slot_addr(j);
          if mem_load(oaddr + 4) == 0 {
            let ox = mem_load(oaddr);
            let oy = mem_load(oaddr + 1);
            let dx = sx - ox;
            let dy = sy - oy;
            let adx = abs_val(dx);
            let ady = abs_val(dy);
            if adx < 150 && ady < 150 {
              coh_x = coh_x + ox;
              coh_y = coh_y + oy;
              ali_x = ali_x + mem_load(oaddr + 2);
              ali_y = ali_y + mem_load(oaddr + 3);
              neighbors = neighbors + 1;
              if adx < 48 && ady < 48 {
                sep_x = sep_x + dx;
                sep_y = sep_y + dy;
              } else { () };
            } else { () };
          } else { () };
        } else { () };
        j = j + 1;
      }

      let mut ax = sep_x / 10;
      let mut ay = sep_y / 10;

      if neighbors > 0 {
        let cx = coh_x / neighbors;
        let cy = coh_y / neighbors;
        ax = ax + (cx - sx) / 48 + (ali_x / neighbors) / 4;
        ay = ay + (cy - sy) / 48 + (ali_y / neighbors) / 4;
      } else { () };

      let ldx = sx - lion_x;
      let ldy = sy - lion_y;
      let dist_sq = ldx * ldx + ldy * ldy;
      let mut max_spd = 4;
      if dist_sq < scare_sq {
        max_spd = if roaring > 0 { 13 } else { 9 };
        let push = if roaring > 0 { 12 } else { 8 };
        let approx_d = abs_val(ldx) + abs_val(ldy) + 12;
        if approx_d > 0 {
          ax = ax + (ldx * push) / approx_d;
          ay = ay + (ldy * push) / approx_d;
        } else { () };
      } else {
        let r = next_rand();
        if (r & 15) == 0 {
          ax = ax + ((r >> 4) & 3) - 1;
          ay = ay + ((r >> 7) & 3) - 1;
        } else { () };
      };

      if sx >= 590 && sx <= 735 && sy >= 165 && sy <= 315 {
        ax = ax + 4;
        ay = ay + (240 - sy) / 20;
      } else { () };

      let damped_vx = (svx * 7) / 8 + ax;
      let damped_vy = (svy * 7) / 8 + ay;
      let mut nvx = clamp_vel(damped_vx, max_spd);
      let mut nvy = clamp_vel(damped_vy, max_spd);
      let mut nx = clamp_arena(sx + nvx);
      let mut ny = clamp_arena(sy + nvy);

      if nx <= 44 { nvx = abs_val(nvx) + 2; } else { () };
      if nx >= 980 { nvx = -abs_val(nvx) - 2; } else { () };
      if ny <= 44 { nvy = abs_val(nvy) + 2; } else { () };
      if ny >= 980 { nvy = -abs_val(nvy) - 2; } else { () };

      let in_gate_y = ny >= 165 && ny <= 315;
      if sx < 700 && nx >= 694 && ny >= 104 && ny <= 376 && !in_gate_y {
        nx = 693;
        nvx = -abs_val(nvx);
      } else { () };
      if sy < 110 && ny >= 104 && nx >= 694 && nx <= 966 {
        ny = 103;
        nvy = -abs_val(nvy);
      } else { () };
      if sy > 370 && ny <= 376 && nx >= 694 && nx <= 966 {
        ny = 377;
        nvy = abs_val(nvy);
      } else { () };

      let nyaw = yaw_from_vel(nvx, nvy, prev_yaw);

      if nx >= 722 && nx <= 956 && ny >= 122 && ny <= 358 {
        mem_store(addr, clamp_corral_x(nx));
        mem_store(addr + 1, clamp_corral_y(ny));
        mem_store(addr + 2, 2);
        mem_store(addr + 3, 0);
        mem_store(addr + 4, 1);
        mem_store(addr + 5, 8);
        mem_store(addr + 7, nyaw);
        mem_store(16, 2);
        penned_total = penned_total + 1;
      } else {
        let spd = abs_val(nvx) + abs_val(nvy);
        let hop_step = if spd > 6 { 3 } else { if spd > 1 { 2 } else { 0 } };
        mem_store(addr, nx);
        mem_store(addr + 1, ny);
        mem_store(addr + 2, nvx);
        mem_store(addr + 3, nvy);
        mem_store(addr + 5, (hop + hop_step) & 31);
        mem_store(addr + 7, nyaw);
      };
    };

    i = i + 1;
  }

  penned_total
}

export fn init_game(seed: i64) -[Mem, Gpu]-> i64 {
  let clean_seed = if seed <= 0 { 424242 } else { seed & 0x7FFFFFFF };
  mem_store(0, 0);
  mem_store(1, 220);
  mem_store(2, 780);
  mem_store(3, 0);
  mem_store(4, 0);
  mem_store(5, 100);
  mem_store(6, 0);
  mem_store(7, 0);
  mem_store(8, 0);
  mem_store(9, clean_seed);
  mem_store(10, 0);
  mem_store(11, 0);
  mem_store(12, 0);
  mem_store(13, 0);
  mem_store(14, 1536); // Facing +X/-Z toward the flock & corral!
  mem_store(16, 0);

  init_trig_4096();
  bake_savanna_hd_textures();
  build_savanna_3d_world();

  let mut i = 0;
  while i >= 0 && i < 14 max 14 {
    let addr = sheep_slot_addr(i);
    let rx = next_rand();
    let ry = next_rand();
    let sx = clamp_arena(180 + (rx & 511));
    let sy = clamp_arena(320 + (ry & 511));
    mem_store(addr, sx);
    mem_store(addr + 1, sy);
    mem_store(addr + 2, ((rx >> 9) & 3) - 1);
    mem_store(addr + 3, ((ry >> 9) & 3) - 1);
    mem_store(addr + 4, 0);
    mem_store(addr + 5, (i * 5) & 31);
    mem_store(addr + 6, i - (i / 3) * 3);
    mem_store(addr + 7, (i * 512) & 4095);
    i = i + 1;
  }

  save_snapshot();
  build_dynamic_savanna_3d()
}

// Note: when `ptr_active > 0`, `ptr_wx` and `ptr_wy` are exact 3D raycast meadow coordinates (`0..1024`)!
export fn step_game(
  dx_in: i64,
  dy_in: i64,
  roar_in: i64,
  ptr_active: i64,
  ptr_wx: i64,
  ptr_wy: i64
) -[Mem, Gpu]-> i64 {
  let tick = mem_load(0) + 1;
  mem_store(0, tick);

  let lx = mem_load(1);
  let ly = mem_load(2);
  let mut lvx = mem_load(3);
  let mut lvy = mem_load(4);
  let mut stamina = mem_load(5);
  let mut roar_timer = mem_load(6);

  if roar_in > 0 && stamina >= 28 && roar_timer == 0 {
    roar_timer = 24;
    stamina = stamina - 28;
    mem_store(16, 1);
  } else {
    if roar_timer > 0 {
      roar_timer = roar_timer - 1;
    } else {
      if stamina < 100 && (tick & 1) == 0 {
        stamina = stamina + 1;
      } else { () };
    };
  };

  let lion_max = if roar_timer > 10 { 15 } else { 10 };

  let mut wish_wx = 0;
  let mut wish_wy = 0;
  if dx_in != 0 || dy_in != 0 {
    // Matches 3D Isometric Camera `eye = [+7.3m, +8.4m, +7.3m]`:
    // Right (+1,0) -> (+wx,-wy); Left (-1,0) -> (-wx,+wy); Up (0,-1) -> (-wx,-wy); Down (0,+1) -> (+wx,+wy)!
    wish_wx = (dy_in + dx_in) * 4;
    wish_wy = (dy_in - dx_in) * 4;
  } else {
    if ptr_active > 0 {
      let pdx = ptr_wx - lx;
      let pdy = ptr_wy - ly;
      if abs_val(pdx) > 14 || abs_val(pdy) > 14 {
        wish_wx = clamp_vel(pdx / 6, 6);
        wish_wy = clamp_vel(pdy / 6, 6);
      } else { () };
    } else { () };
  };

  lvx = clamp_vel((lvx * 3) / 4 + wish_wx, lion_max);
  lvy = clamp_vel((lvy * 3) / 4 + wish_wy, lion_max);

  let mut nlx = clamp_arena(lx + lvx);
  let mut nly = clamp_arena(ly + lvy);

  if nlx >= 688 && nlx <= 968 && nly >= 102 && nly <= 378 {
    if lx < 688 {
      nlx = 687;
    } else {
      if ly < 102 { nly = 101; } else { if ly > 378 { nly = 379; } else { nlx = 687; } };
    };
  } else { () };

  let lspd = abs_val(lvx) + abs_val(lvy);
  let lhop = if lspd > 2 { (mem_load(13) + 1) & 15 } else { 0 };
  if lspd > 1 {
    mem_store(14, yaw_from_vel(lvx, lvy, mem_load(14)));
  } else { () };

  mem_store(1, nlx);
  mem_store(2, nly);
  mem_store(3, lvx);
  mem_store(4, lvy);
  mem_store(5, stamina);
  mem_store(6, roar_timer);
  mem_store(13, lhop);

  let penned = step_sheep_flock(nlx, nly, roar_timer);
  let safe_penned = if penned < 0 { 0 } else { if penned > 14 { 14 } else { penned } };
  mem_store(7, safe_penned);

  if safe_penned == 14 && mem_load(10) == 0 {
    mem_store(10, tick);
    mem_store(16, 3);
  } else { () };

  let ref_tick = if mem_load(10) > 0 { mem_load(10) } else { tick };
  let raw_bonus = 2000 - ref_tick / 2;
  let speed_bonus = if safe_penned == 0 {
    0
  } else {
    if raw_bonus < 0 { 0 } else { if raw_bonus > 2000 { 2000 } else { raw_bonus } }
  };
  mem_store(8, compute_herd_score(safe_penned, speed_bonus));

  if (tick & 3) == 0 {
    save_snapshot();
  } else { () };

  build_dynamic_savanna_3d()
}

export fn rewind_to_snapshot(steps_back: i64) -[Mem, Gpu]-> i64 {
  let cnt = mem_load(12);
  if cnt <= 0 {
    build_dynamic_savanna_3d()
  } else {
    let clamped_back = if steps_back < 0 {
      0
    } else {
      if steps_back >= cnt { cnt - 1 } else { steps_back }
    };
    let head = mem_load(11);
    let raw_idx = head - 1 - clamped_back;
    let wrapped = if raw_idx < 0 { raw_idx + 240 } else { raw_idx };
    let safe_slot = if wrapped < 0 { 0 } else { if wrapped >= 240 { 0 } else { wrapped } };
    let base = snapshot_slot_addr(safe_slot);

    let mut h = 0;
    while h >= 0 && h < 11 max 11 {
      mem_store(h, mem_load(base + h));
      h = h + 1;
    }
    mem_store(13, mem_load(base + 13));
    mem_store(14, mem_load(base + 14));

    let mut s = 0;
    while s >= 0 && s < 14 max 14 {
      let saddr = sheep_slot_addr(s);
      let daddr = base + 16 + s * 4;
      let ppos = mem_load(daddr);
      let pvel = mem_load(daddr + 1);
      let meta = mem_load(daddr + 2);
      mem_store(saddr, (ppos >> 12) & 2047);
      mem_store(saddr + 1, ppos & 2047);
      mem_store(saddr + 2, ((pvel >> 8) & 255) - 64);
      mem_store(saddr + 3, (pvel & 255) - 64);
      mem_store(saddr + 4, (meta >> 20) & 3);
      mem_store(saddr + 5, (meta >> 15) & 31);
      mem_store(saddr + 6, (meta >> 12) & 7);
      mem_store(saddr + 7, meta & 4095);
      s = s + 1;
    }

    build_dynamic_savanna_3d()
  }
}

// --- Exported GPU Offsets & Telemetry ---

export fn get_tex_byte_offset() -> i64
  ens result == 262144
{
  262144
}

export fn get_static_vbo_byte_offset() -> i64
  ens result == 2400000
{
  2400000
}

export fn get_dyn_vbo_byte_offset() -> i64
  ens result == 4400000
{
  4400000
}

export fn get_lights_byte_offset() -> i64
  ens result == 100000
{
  100000
}

export fn get_shadows_byte_offset() -> i64
  ens result == 1200
{
  1200
}

export fn get_static_vert_count() -[Mem]-> i64 { mem_load(20) }
export fn get_dyn_vert_count() -[Mem]-> i64 { mem_load(21) }
export fn get_light_count() -[Mem]-> i64 { mem_load(22) }

export fn pop_sfx() -[Mem]-> i64 {
  let ev = mem_load(16);
  mem_store(16, 0);
  ev
}

export fn get_penned() -[Mem]-> i64 { mem_load(7) }
export fn get_score() -[Mem]-> i64 { mem_load(8) }
export fn get_stamina() -[Mem]-> i64 { mem_load(5) }
export fn get_tick() -[Mem]-> i64 { mem_load(0) }
export fn get_win_tick() -[Mem]-> i64 { mem_load(10) }
export fn get_snap_count() -[Mem]-> i64 { mem_load(12) }
